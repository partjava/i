# DeepSeek 官方 API 配置 (2026-10 DeepSeek-V4 系列)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 双模型名称配置
# deepseek-flash -> DeepSeek-V4.1-Flash-1017 (1M上下文 + Vision + 思考/非思考模式)
DEEPSEEK_MODEL_FLASH=deepseek-flash
# deepseek-v4-pro -> DeepSeek-V4-Pro-0813 (强推理 + 原生内置 web_search 工具)
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# DeepSeek 2026-10-17 官方独立搜索与网页抓取工具端点
DEEPSEEK_SEARCH_URL=https://api.deepseek.com/v1/tools/search
DEEPSEEK_FETCH_URL=https://api.deepseek.com/v1/tools/fetch

# 服务监听端口
PORT=8000
