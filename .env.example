# 复制此文件为 .env.local（本地开发）或 .env.production（生产）
# cp .env.example .env.local
# 真实密钥统一保存在私有数据仓 partjavadata/secrets/，严禁提交到本仓库

# 数据库（后端 Spring Boot 通过同名变量读取）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=partjava_notes

# JWT 签名密钥（后端必需；未配置时启动会生成一次性随机密钥并告警）
JWT_SECRET=your-jwt-secret-at-least-32-bytes

# AI 服务（DeepSeek）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_FLASH=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# Python FastAPI Agent 服务（可选；未启动时 Next.js 自动降级为内置 Agent 引擎）
FASTAPI_AGENT_URL=http://127.0.0.1:8000

# 代码执行 (RapidAPI Judge0)
JUDGE0_API_KEY=your-judge0-api-key
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# 其他 AI（可选）
GLM_API_KEY=your-glm-api-key
